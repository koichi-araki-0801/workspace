{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @editor/shared run build && pnpm --parallel --filter server --filter web run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:server": "pnpm --filter server run dev",
    "build": "tsc -b editor/server && pnpm --filter web run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c editor/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc -b editor/server && pnpm --filter web --filter pie-chart --filter graph-editor run typecheck",
    "pie-chart:cli": "pnpm --filter pie-chart run cli",
    "pie-chart:check": "pnpm --filter pie-chart run check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "check:comments": "node scripts/check-comments.mjs",
    "knip": "knip",
    "ci": "pnpm run check:comments && pnpm run check:ci && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run test:e2e",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "editor/**/*.{ts,vue,css,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "knip": "^5.66.0",
    "lint-staged": "^17.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
