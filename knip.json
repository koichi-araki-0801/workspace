{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["editor/e2e/tools/e2e-vite.ts"]
    },
    "editor/server": {
      "entry": [
        "scripts/hash-password.ts",
        "scripts/gen-seed.ts",
        "scripts/pdf-build-worker.mjs",
        "scripts/pdf-build-worker-daemon.mjs",
        "scripts/e2e-rest-server.ts"
