{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/pre-push.mjs"]
    },
    "editor/server": {
      "entry": [
        "scripts/hash-password.ts",
