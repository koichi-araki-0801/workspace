# Offline-friendly defaults（editor/.npmrc から継承）
audit=false
fund=false
engine-strict=true

# 非対話: node_modules 作り直し時の確認プロンプトを抑止（CI/自動化向け）
confirm-modules-purge=false

# pnpm run/exec 前の依存整合チェックで自動 install を走らせない。
# オフライン環境では prune/再 install がネットに出て失敗するため無効化する。
# （install 済みの node_modules はストアへのハードリンクで自己完結している）
verify-deps-before-run=false

# isolated linker を維持。public-hoist-pattern を独自指定すると pnpm の既定
# (*types*, *eslint*) を上書きしてしまうため、既定を明示的に再掲したうえで
# vivliostyle を追加する。*types* の hoist は express 等の TS2742 回避に必須。
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@vivliostyle/*
