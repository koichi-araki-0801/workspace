node_modules/
dist/
*.log
.DS_Store
.env
.env.local
# Local runtime config (copy from appconfig.example.json); may hold machine-specific paths
appconfig.json
coverage/
.vite/
.tmp/
tmp/
*.tsbuildinfo
# Python バイトコードキャッシュ（コミット対象外）
__pycache__/
*.pyc
# ローカル開発支援ツールの設定・作業ファイル（マシン固有。リポジトリでは共有しない）
.claude/
CLAUDE.md
AGENTS.md
# 配布担当の端末にだけ置くバンドル生成スクリプトと、撤去した配布機構の複製
local-only/
pie-chart/.claude/
# code-review-graph（MCP）のグラフ DB と MCP 設定（絶対パスを含むマシン固有）
.code-review-graph/
.mcp.json
# vivliostyle / playwright artifacts
playwright-report/
test-results/
# pnpm

# オフラインバンドル生成物（コミット対象外。重量物は GitHub Releases へ）
.pnpm-store/
pnpm.tgz
ms-playwright/
# Python ビルド依存の wheel（pip download で生成し重量物バンドルへ同梱）
python-wheelhouse/
*.tar.gz
*.tar.gz.part-*
# Release 公開時の付随生成物
offline-deps-bundle.tar.gz.sha256
offline-deps-lite.tar.gz.sha256
bundle.key
_bundle_stage/
# オフライン環境構築後、ダウンロード物（ソースZIP/バンドル/sha256/key）の退避先
bk/
# 遮断端末で展開先の直下へ置くソース差分パッチ（本番修正キットを含む）。knip と git status に載せない
/patch-*-to-*/
# git/TortoiseGit の同梱バイナリ（重量物。content key 差分で再配布）
git-tools/
# docs の Mermaid ランタイムと ELK レイアウト（計 ~4.3MB。git に入れず重量物バンドルへ同梱し
# setup が vendor へ展開。版は docs/_build/vendor/manifest.txt が規定し content key に折り込まれる）
docs/_build/vendor/mermaid.min.js
docs/_build/vendor/mermaid-layout-elk.min.js
# 旧 msnodesqlv8（4.x）の公式 prebuild（.node 入り tar.gz）。6.0.0 からは npm tarball の prebuilds\ に
# N-API の .node が入るので使わない。手元に残った古い tar.gz を誤ってコミットしないために残す
native-prebuilds/*.tar.gz
# 遮断端末向けソース ZIP（publish の生成物、および遮断端末の setup が展開段でリポジトリ直下に残すもの。
# clone 運用の端末で誤って生成されても追跡しないため）
source.zip
source.zip.sha256
MANIFEST
SOURCE-COMMIT
