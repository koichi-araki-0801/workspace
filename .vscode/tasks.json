{
	"version": "2.0.0",
	// 既存の pnpm スクリプト(`package.json` / 各パッケージ)をタスク化する。
	"tasks": [
		{
			"label": "dev (server + web)",
			"type": "shell",
			"command": "pnpm run dev",
			"isBackground": true,
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "pnpm run build",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "test",
			"type": "shell",
			"command": "pnpm run test",
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "typecheck",
			"type": "shell",
			"command": "pnpm run typecheck",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "check (biome 整形)",
			"type": "shell",
			"command": "pnpm run check",
			"problemMatcher": []
		},
		{
			"label": "check:ci (biome 検査)",
			"type": "shell",
			"command": "pnpm run check:ci",
			"problemMatcher": []
		},
		{
			"label": "pie-chart: batch",
			"type": "shell",
			"command": "pnpm --filter pie-chart run batch",
			"problemMatcher": []
		},
		{
			"label": "pie-chart: verify",
			"type": "shell",
			"command": "pnpm --filter pie-chart run verify",
			"problemMatcher": []
		}
	]
}
